          "stringUnit": {
            "state": "translated",
            "value": "Sarria"
          }
        }
      }
    },
    "Dernière ville permettant d'obtenir la Compostela en marchant le minimum requis — 100 km à pied.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
