      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bolsena"
          }
        }
      }
    },
    "Sur les rives du plus grand lac volcanique d'Europe. Le miracle eucharistique de 1263 y fit naître la Fête-Dieu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the shores of the largest volcanic lake in Europe. The Eucharistic Miracle of 1263 gave rise to the feast of Corpus Christi here."
          }
        }
      }
    },
