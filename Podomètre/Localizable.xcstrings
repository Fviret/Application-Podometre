      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auberge U Vallone"
          }
        }
      }
    },
    "Au pied du Monte Cinto, plus haut sommet de Corse. La partie la plus alpine du parcours nord est franchie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the foot of Monte Cinto, Corsica's highest peak. The most alpine part of the northern route is behind you."
          }
        }
      }
    },
