            "state": "translated",
            "value": "Cap Fréhel → Dahouet — 65 km"
          }
        }
      }
    },
    "Cap Fréhel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap Fréhel"
          }
        }
      }
    },
    "Le grand phare rouge et blanc domine des falaises de grès rose. Départ face à la Manche, embruns garantis.": {
      "localizations": {
        "en": {
          "stringUnit": {
