          }
        }
      }
    },
    "Pointe de la Latte": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointe de la Latte"
          }
        }
      }
    },
    "Le fort la Latte, forteresse médiévale posée sur un îlot rocheux relié par une passerelle au-dessus du vide.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fort la Latte, a medieval fortress perched on a rocky islet, linked by a footbridge over the void."
          }
        }
      }
    },
    "Erquy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erquy"
          }
        }
      }
    },
    "Le port aux bateaux de pêche à la coquille Saint-Jacques, niché entre landes de bruyère et plages de sable fin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scallop fishing port, tucked between heather moorland and fine sandy beaches."
          }
        }
      }
    },
