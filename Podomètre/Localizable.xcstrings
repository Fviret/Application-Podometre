      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calenzana"
          }
        }
      }
    },
    "Départ officiel du GR20, au pied des montagnes corses. Le sentier plonge immédiatement dans le maquis odorant.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Official start of the GR20, at the foot of the Corsican mountains. The trail plunges immediately into the fragrant maquis."
          }
        }
      }
    },
