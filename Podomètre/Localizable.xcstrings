      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fortress perched on a volcanic peak, long the lair of the bandit Ghino di Tacco. The view sweeps across all of southern Tuscany."
          }
        }
      }
    },
