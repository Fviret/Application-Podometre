      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Petra Piana Hut"
          }
        }
      }
    },
    "Perché sous les crêtes, face à un panorama de sommets déchiquetés. Le cœur minéral du GR20.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perched beneath the ridgelines, facing a panorama of jagged peaks. The mineral heart of the GR20."
          }
        }
      }
    },
