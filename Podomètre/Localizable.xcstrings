          }
        }
      }
    },
    "San Quirico d'Orcia": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "San Quirico d'Orcia"
          }
        }
      }
    },
    "Au cœur du Val d'Orcia et de ses collines ondulées bordées de cyprès. Les Horti Leonini offrent au pèlerin un jardin Renaissance.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
