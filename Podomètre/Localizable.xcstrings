      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vizzavona"
          }
        }
      }
    },
    "Mi-parcours, accessible par le train. La forêt de laricio offre une pause bienvenue après les crêtes exposées.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Halfway point, reachable by train. The laricio forest offers a welcome break after the exposed ridges."
          }
        }
      }
    },
