          "stringUnit": {
            "state": "translated",
            "value": "The Corner Café"
          }
        }
      }
    },
    "William renverse du jus d'orange sur Anna en se faisant passer pour un journaliste — un mensonge maladroit et charmant.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "William spills orange juice on Anna while pretending to be a journalist — an awkward, charming lie."
          }
        }
      }
    },
